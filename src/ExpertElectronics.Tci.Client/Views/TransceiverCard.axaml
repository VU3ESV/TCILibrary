<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExpertElectronics.Tci.Client.ViewModels"
             x:Class="ExpertElectronics.Tci.Client.Views.TransceiverCard"
             x:DataType="vm:TransceiverViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="Inter, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Border Padding="12" Margin="0,4,0,4" CornerRadius="6" Background="#23232A" BorderBrush="#444" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,16,Auto,16,Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding DisplayName}"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Classes="value" VerticalAlignment="Center" Text="{Binding Modulation}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Classes="value" VerticalAlignment="Center" Text="{Binding VfoADisplay}"/>

            <Button Grid.Row="0" Grid.Column="6" Content="Start RX" Click="OnStartRxClick"
                    IsEnabled="{Binding !RxAudioRunning}" Margin="0,0,6,0"/>
            <Button Grid.Row="0" Grid.Column="7" Content="Stop RX" Click="OnStopRxClick"
                    IsEnabled="{Binding RxAudioRunning}" Margin="0,0,12,0"/>
            <Button Grid.Row="0" Grid.Column="8" Content="Start TX" Click="OnStartTxClick"
                    IsEnabled="{Binding TxFeatureEnabled}" Margin="0,0,6,0"/>
            <Button Grid.Row="0" Grid.Column="9" Content="Stop TX" Click="OnStopTxClick"
                    IsEnabled="{Binding TxAudioRunning}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10" Margin="0,8,0,0"
                       Foreground="#3FA9F5" FontSize="12" Text="{Binding Status}"/>
        </Grid>
    </Border>
</UserControl>
